{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>middleware/buildenv/renovate-presets:image"
  ],
  "packageRules": [
    {
      "description": "Artemis version updates",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "middleware-docker.repo.pnet.ch/arkmq-org/activemq-artemis-broker-kubernetes"
      ],
      "extractVersion": "artemis.(?<version>\\d+\\.\\d+\\.\\d+)$",
      "automerge": false,
      "addLabels": [
        "wf::Blocked"
      ]
    }
  ]
}
