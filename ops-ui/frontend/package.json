{
  "name": "mqp-ops-ui",
  "version": "0.0.2-5",
  "description": "MQP OPS UI",
  "scripts": {
    "ng": "ng",
    "start-frontend": "ng serve --proxy-config=proxy.conf.json",
    "start-backend": "cd ../backend && mvn spring-boot:run",
    "build:mqp-ops-ui": "ng build --configuration production --base-href=/mqp-ops-ui/ --output-path=dist/mqp-ops-ui",
    "build:mqp-ops-ui-nonprod": "ng build --configuration production --base-href=/mqp-ops-ui-nonprod/ --output-path=dist/mqp-ops-ui-nonprod",
    "build": "npm run build:mqp-ops-ui && npm run build:mqp-ops-ui-nonprod",
    "build-local-with-auth": "ng build --configuration local-with-auth --base-href=/mqp-ops-ui/ --output-path=dist",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "analyze": "ng build --stats-json && webpack-bundle-analyzer dist/postfinance-angular-skeleton/stats.json",
    "prettify": "prettier --write .",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@ngx-translate/core": "^16.0.0",
    "@ngx-translate/http-loader": "^16.0.0",
    "@postfinance/component-library": "8.26.0",
    "@postfinance/component-library-angular": "8.26.0",
    "@postfinance/util-library": "4.9.0",
    "globals": "16.5.0",
    "js-beautify": "^1.15.4",
    "rxjs": "^7.4.0",
    "typescript-eslint": "^8.0.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/jasmine": "6.0.0",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^24.0.0",
    "angular-eslint": "^20.0.0",
    "depcheck": "^1.4.7",
    "eslint": "9.39.5",
    "husky": "^9.1.7",
    "jasmine-core": "^5.0.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.0.0",
    "webpack-bundle-analyzer": "5.4.0"
  },
  "vaadin": {
    "disableUsageStatistics": true
  }
}
